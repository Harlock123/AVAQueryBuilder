<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AVAQueryBuilder"
        x:Class="AVAQueryBuilder.AddConnectedSourceDialog"
        Title="Add Connected Source (Lookup Join)"
        Width="950" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="16" RowDefinitions="*,Auto">

        <!-- Four columns of listboxes -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*">

            <!-- Column 1: Fields from source table -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,4,0">
                <TextBlock Grid.Row="0" x:Name="txtSourceHeader"
                           Text="Field(s) to Use in Connection"
                           FontWeight="SemiBold" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lstSourceFields" MinWidth="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ColumnItem">
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- Column 2: Tables/Views to connect to -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="4,0,4,0">
                <TextBlock Grid.Row="0"
                           Text="Table/View to Connect To"
                           FontWeight="SemiBold" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lstLookupTables" MinWidth="200"
                             SelectionMode="Single"
                             SelectionChanged="LstLookupTables_SelectionChanged" />
                </ScrollViewer>
            </Grid>

            <!-- Column 3: Fields to connect with (join key) -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="4,0,4,0">
                <TextBlock Grid.Row="0"
                           Text="Field to Connect With"
                           FontWeight="SemiBold" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lstJoinFields" MinWidth="200"
                             SelectionMode="Single"
                             SelectionChanged="LstJoinFields_SelectionChanged" />
                </ScrollViewer>
            </Grid>

            <!-- Column 4: Fields to return on match -->
            <Grid Grid.Column="3" RowDefinitions="Auto,Auto,*" Margin="4,0,0,0">
                <TextBlock Grid.Row="0"
                           Text="Fields to Return on Match"
                           FontWeight="SemiBold" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="Select" FontSize="10"
                               Foreground="Gray" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="Alias (optional)" FontSize="10"
                               Foreground="Gray" />
                </Grid>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lstReturnFields" MinWidth="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ColumnItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Grid.Column="0" Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected}" />
                                    <TextBox Grid.Column="1" Text="{Binding Alias}"
                                             Watermark="alias" FontSize="11"
                                             Margin="4,0,0,0" Height="28"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status and buttons -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
            <TextBlock x:Name="txtStatus" Grid.Row="0" FontSize="10"
                       Foreground="Gray" Margin="0,0,0,8" />
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="cmdOk" Content="OK" Width="80"
                        Click="CmdOk_Click" />
                <Button x:Name="cmdCancel" Content="Cancel" Width="80"
                        Click="CmdCancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
