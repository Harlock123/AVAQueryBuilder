<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AVAQueryBuilder.AddCaseWhenDialog"
        Title="Add CASE/WHEN Expression"
        Width="900" Height="550"
        WindowStartupLocation="CenterOwner"
        CanResize="True" MinWidth="700" MinHeight="400">
    <Grid Margin="16" RowDefinitions="*,Auto,Auto,Auto">

        <!-- Case expressions list -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="casePanels" Spacing="12" />
        </ScrollViewer>

        <!-- Add case button -->
        <Button Grid.Row="1" Content="+ Add Case Expression" Margin="0,8,0,8"
                HorizontalAlignment="Left" Click="CmdAddCase_Click" />

        <!-- Preview -->
        <StackPanel Grid.Row="2" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="Preview:" FontSize="10" Foreground="Gray" />
            <TextBlock x:Name="txtPreview" FontSize="11" FontFamily="Consolas"
                       TextWrapping="Wrap" Foreground="DarkBlue" MaxHeight="80" />
        </StackPanel>

        <!-- Status and buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="txtStatus" Grid.Column="0" FontSize="10"
                       Foreground="Gray" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="cmdOk" Content="OK" Width="80"
                        Click="CmdOk_Click" />
                <Button x:Name="cmdCancel" Content="Cancel" Width="80"
                        Click="CmdCancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
