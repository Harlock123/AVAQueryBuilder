<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AVAQueryBuilder.ConnectionStringDialog"
        Title="Connect to a Database"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <!-- Engine -->
        <TextBlock Grid.Row="0" Text="Database Engine:" Margin="0,0,0,2" FontSize="12" />
        <ComboBox x:Name="cboEngine" Grid.Row="1" HorizontalAlignment="Stretch"
                  Margin="0,0,0,8" SelectedIndex="0"
                  SelectionChanged="CboEngine_SelectionChanged">
            <ComboBoxItem Content="SQL Server" />
            <ComboBoxItem Content="PostgreSQL" />
            <ComboBoxItem Content="SQLite" />
        </ComboBox>

        <!-- Server, host or file -->
        <TextBlock x:Name="lblServer" Grid.Row="2" Text="Server Name:" Margin="0,0,0,2" FontSize="12" />
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <ComboBox x:Name="cboServer" Grid.Column="0" IsEditable="True"
                      HorizontalAlignment="Stretch" />
            <Button x:Name="cmdBrowseServers" Grid.Column="1" Content="Browse..."
                    Margin="4,0,0,0" Click="CmdBrowseServers_Click" />
        </Grid>

        <!-- Authentication (SQL Server only) -->
        <StackPanel x:Name="pnlAuth" Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Authentication:" Margin="0,0,0,2" FontSize="12" />
            <ComboBox x:Name="cboAuth" HorizontalAlignment="Stretch" SelectedIndex="0"
                      SelectionChanged="CboAuth_SelectionChanged">
                <ComboBoxItem Content="Windows Authentication" />
                <ComboBoxItem Content="SQL Server Authentication" />
            </ComboBox>
        </StackPanel>

        <!-- Username / Password -->
        <Grid x:Name="pnlCredentials" Grid.Row="5" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
              Margin="0,0,0,8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:"
                       VerticalAlignment="Center" Margin="0,0,8,4" FontSize="12" />
            <TextBox x:Name="txtUsername" Grid.Row="0" Grid.Column="1"
                     IsEnabled="False" Margin="0,0,0,4"
                     TextChanged="Field_TextChanged" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:"
                       VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
            <TextBox x:Name="txtPassword" Grid.Row="1" Grid.Column="1"
                     IsEnabled="False" PasswordChar="*"
                     TextChanged="Field_TextChanged" />
        </Grid>

        <!-- Database (not for SQLite: the file is the database) -->
        <StackPanel x:Name="pnlDatabase" Grid.Row="6" Margin="0,0,0,12">
            <TextBlock Text="Database:" Margin="0,0,0,2" FontSize="12" />
            <Grid ColumnDefinitions="*,Auto">
                <ComboBox x:Name="cboDatabase" Grid.Column="0" IsEditable="True"
                          HorizontalAlignment="Stretch" />
                <Button x:Name="cmdRefreshDatabases" Grid.Column="1" Content="Refresh"
                        Margin="4,0,0,0" Click="CmdRefreshDatabases_Click" />
            </Grid>
        </StackPanel>

        <!-- Connection String result -->
        <StackPanel Grid.Row="9" Spacing="2" VerticalAlignment="Top">
            <TextBlock Text="Connection String (editable):" FontSize="12" />
            <TextBox x:Name="txtConnectionString" AcceptsReturn="True"
                     Height="60" TextWrapping="Wrap" />
            <TextBlock x:Name="txtStatus" FontSize="10" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="10" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="cmdTestConnection" Content="Test Connection"
                    Click="CmdTestConnection_Click" />
            <Button x:Name="cmdOk" Content="OK" Width="80"
                    Click="CmdOk_Click" />
            <Button x:Name="cmdCancel" Content="Cancel" Width="80"
                    Click="CmdCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
