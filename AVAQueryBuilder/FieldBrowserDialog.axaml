<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lawgrid="clr-namespace:LAWgrid;assembly=LAWgrid"
        x:Class="AVAQueryBuilder.FieldBrowserDialog"
        Title="Field Browser"
        Width="1000" Height="650"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid Margin="8" RowDefinitions="*,Auto">

        <lawgrid:LAWgrid x:Name="BrowserGrid" Grid.Row="0" />

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" Width="100" Click="CmdClose_Click" />
        </StackPanel>
    </Grid>
</Window>
