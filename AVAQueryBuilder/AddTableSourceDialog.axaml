<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AVAQueryBuilder"
        x:Class="AVAQueryBuilder.AddTableSourceDialog"
        Title="Add Table Source"
        Width="850" Height="600"
        MinWidth="650" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid Margin="16" RowDefinitions="*,Auto">

        <!-- Main content area: Left | Splitter | Right -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,1.5*">

            <!-- Left: Tables and Views with splitter between them -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto,*">

                <TextBlock Grid.Row="0" Text="Tables:" FontWeight="SemiBold"
                           FontSize="12" Margin="0,0,0,4" />
                <ListBox x:Name="lstTables" Grid.Row="1"
                         SelectionChanged="LstTables_SelectionChanged" />

                <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows"
                              Background="DarkGray" Margin="0,4" />

                <TextBlock Grid.Row="3" Text="Views:" FontWeight="SemiBold"
                           FontSize="12" Margin="0,0,0,4" />
                <ListBox x:Name="lstViews" Grid.Row="4"
                         SelectionChanged="LstViews_SelectionChanged" />
            </Grid>

            <!-- Splitter between left and right -->
            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                          Background="DarkGray" Margin="8,0" />

            <!-- Right: Columns checklist with aliases -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <TextBlock x:Name="txtColumnsHeader" Grid.Row="0"
                           Text="Columns:" FontWeight="SemiBold"
                           FontSize="12" Margin="0,0,0,4" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="Select" FontSize="10"
                               Foreground="Gray" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="Alias (optional)" FontSize="10"
                               Foreground="Gray" />
                </Grid>
                <ListBox x:Name="lstColumns" Grid.Row="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ColumnItem">
                            <Grid ColumnDefinitions="Auto,*">
                                <CheckBox Grid.Column="0" Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}" />
                                <TextBox Grid.Column="1" Text="{Binding Alias}"
                                         Watermark="alias" FontSize="11"
                                         Margin="4,0,0,0" Height="28"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Status and buttons -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
            <TextBlock x:Name="txtStatus" Grid.Row="0" FontSize="10"
                       Foreground="Gray" Margin="0,0,0,8" />
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8">
                <Button Content="Field Browser" Click="CmdFieldBrowser_Click" />
                <Button Content="Select All" Click="CmdSelectAll_Click" />
                <Button Content="Select None" Click="CmdSelectNone_Click" />
                <Button x:Name="cmdOk" Content="OK" Width="80"
                        Click="CmdOk_Click" />
                <Button x:Name="cmdCancel" Content="Cancel" Width="80"
                        Click="CmdCancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
